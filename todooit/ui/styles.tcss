# Extra vars

$border_type: round;


# CSS

Screen {
    background: $background1;
}

#empty-pane {
    background: $background1;
    border: $border_type $background3;
}

ModelTree {
    background: $background1;
    background-tint: white 0%;
    color: $foreground3;
    border: $border_type $background3;
    padding: 1 0;

    border-title-color: $foreground1;
    border-title-background: $background1;

    &:focus {
        border: $border_type $primary;

        .option-list--option-highlighted {
            background: $secondary 40%;
            color: $foreground3;
        }
    }

    # --------- Options ------------------

    .option-list--option-disabled {
        color: $foreground1 50%;
    }

    .option-list--option-highlighted {
        background: $background3;
    }

    .option-list--option-hover {
        background: $background1;
        color: $foreground3;
    }
}

DooitKeyTable {
  .keybind {
    color: $primary;
  }

  .arrow {
    color: $foreground1 60%;
  }

  .description {
    color: $secondary;
    text-style: bold;
  }

  .table-title {
    color: $background1;
    background: $primary;
  }

  .separator {
    color: $foreground1 30%;
  }
}

/* Wraps the whole note (text + files) in one border */
NoteFrame {
  background: $background2;
  border-title-background: $primary;
  border-title-color: $background1;
  border-title-align: center;
  padding: 0 1;

  /* The mode chip, bottom left as lualine's section A, in its colors for
     LazyVim; the border takes the chip's color with it */
  border: $border_type $blue;
  border-subtitle-background: $blue;
  border-subtitle-color: $background1;
  border-subtitle-style: bold;
  border-subtitle-align: left;

  &.-insert {
    border: $border_type $green;
    border-subtitle-background: $green;
  }

  &.-visual {
    border: $border_type $magenta;
    border-subtitle-background: $magenta;
  }

  &.-flash {
    border: $border_type $orange;
    border-subtitle-background: $orange;
  }
}

/* No own border: TextArea's default border would double up inside the frame's */
NoteEditor {
  scrollbar-size-vertical: 0;
  background: $background2;
  border: none;
  padding: 0;
}

/* Files listed along the bottom, left-aligned, as a caption under the note */
#note-files {
  background: $background2;
  text-align: left;
}

#note-hint {
  /* Kept with nothing in it, so the window doesn't move when a hint comes */
  min-height: 1;
  color: $foreground1 60%;
  text-align: center;

  /* Doubles as the y/N confirm prompt; red like the confirm bar */
  &.confirming {
    color: $red;
    text-style: bold;
  }
}

/* The one-line windows (quick add, move, find), laid over the dimmed app */
PanelScreen {
  align: center middle;
  background: $background1 70%;

  & > #panel {
    width: 70%;
    height: auto;
    background: $background2;
    border: $border_type $secondary;
    border-title-background: $primary;
    border-title-color: $background1;
    border-title-align: center;
    padding: 0 1;
  }

  & > #hint {
    width: 70%;
    padding: 0 2;
    color: $foreground1 60%;
    text-align: center;
  }
}

/* The finder is wider: each row carries a task, its deadline and its project */
SearchScreen {
  & > #panel {
    width: 80%;

    /* The cursor position in the whole list of matches */
    border-subtitle-color: $foreground1 60%;
    border-subtitle-align: right;
  }

  & > #hint {
    width: 80%;
  }
}

/* Sized to its content, not the app: a week is 7 days wide regardless of
   terminal width */
CalendarScreen {
  align: center middle;
  background: $background1 70%;

  & > #calendar-panel {
    width: 32;
    height: auto;
    background: $background2;
    border: $border_type $secondary;
    border-title-background: $primary;
    border-title-color: $background1;
    border-title-align: center;
    padding: 0 1;
  }

  /* No side padding: the panel is only a week wide, so every column matters */
  & > #calendar-hint {
    width: 32;
    color: $foreground1 60%;
    text-align: center;
  }
}

/* Capped below screen height so a long listing scrolls inside the panel
   instead of pushing the hint off screen */
HelpScreen {
  align: center middle;
  background: $background1 70%;

  & > #help-panel {
    width: 80%;
    height: auto;
    max-height: 85%;
    background: $background2;
    border: $border_type $secondary;
    border-title-background: $primary;
    border-title-color: $background1;
    border-title-align: center;
    padding: 0 1;
    scrollbar-size-vertical: 1;
  }

  & > #help-hint {
    width: 80%;
    padding: 0 2;
    color: $foreground1 60%;
    text-align: center;
  }
}

# Bars


BarBase {
  background: $background2;
  color: $foreground3;
}

ConfirmBar {
    background: $red;
    color: $background1;
    text-style: bold;
}

NotificationBar {
  color: $background1;

  &.info {
    background: $primary;
  }

  &.warning {
    background: $yellow;
  }

  &.error {
    background: $red;
  }

}

ModelTree > * > Label {
  color: $foreground3 50%;
}

# Miscellaneous

* {
    scrollbar-size: 0 1;
    scrollbar-background: $background3;
    scrollbar-color: $primary;

    scrollbar-background-hover: $background2;
    scrollbar-color-hover: $secondary;

    scrollbar-background-active: $background2;
    scrollbar-color-active: $secondary;

    link-background: $background3;
    link-color: $primary;
 
    link-background-hover: $primary 50%;
    link-color-hover: $background1;

    link-style: italic;
    link-style-hover: italic;
}
